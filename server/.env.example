# ---- Seedream 5.0 Pro provider ----
# mock      -> no API calls, returns the input image back (for UI testing without credits)
# wavespeed -> wavespeed.ai (needs WAVESPEED_API_KEY)  https://wavespeed.ai/models/bytedance/seedream-v5.0-pro/edit
# fal       -> fal.ai (needs FAL_KEY)                  https://fal.ai/models/bytedance/seedream/v5/pro/edit
# ark       -> BytePlus ModelArk (needs ARK_API_KEY)   https://docs.byteplus.com/en/docs/ModelArk/2582774
SEEDREAM_PROVIDER=wavespeed

# wavespeed.ai  (API Keys page: https://wavespeed.ai/accesskey)
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_SEEDREAM_MODEL=bytedance/seedream-v5.0-pro/edit

# fal.ai
FAL_KEY=
SEEDREAM_FAL_MODEL=bytedance/seedream/v5/pro/edit

# BytePlus ModelArk (international) / Volcengine Ark (China)
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_SEEDREAM_MODEL=dola-seedream-5-0-pro-260628

# ---- Background removal ----
# wavespeed -> wavespeed-ai/image-background-remover (needs WAVESPEED_API_KEY, $0.01/image)
# fal       -> fal-ai/birefnet/v2 (needs FAL_KEY)
# client    -> tells the browser to run @imgly/background-removal locally (no key needed)
BG_REMOVAL_PROVIDER=wavespeed
WAVESPEED_BG_MODEL=wavespeed-ai/image-background-remover
BG_REMOVAL_FAL_MODEL=fal-ai/birefnet/v2

# ---- Video Studio (Hypit-style presenter videos) ----
# wavespeed -> Seedream 5.0 Pro (stills, inserts) + Seedance 2.5 (takes) + Whisper (word timings), all on wavespeed.ai
# mock      -> no API calls: reference photo reused as the still, SVG placeholders for inserts, takes without video
VIDEO_PROVIDER=wavespeed
WAVESPEED_SEEDREAM_T2I_MODEL=bytedance/seedream-v5.0-pro
WAVESPEED_SEEDANCE_I2V_MODEL=bytedance/seedance-2.5/image-to-video
WAVESPEED_SEEDANCE_T2V_MODEL=bytedance/seedance-2.5/text-to-video
# Swapping the person inside the original footage (keeps motion, background, on-screen text; generate_audio=false keeps speech)
# bytedance/seedance-2.5/video-edit ($0.22/s in+out at 720p) or bytedance/seedance-2.5/video-edit-turbo (cheaper, <=15 s)
WAVESPEED_SEEDANCE_EDIT_MODEL=bytedance/seedance-2.5/video-edit
WAVESPEED_WHISPER_MODEL=wavespeed-ai/openai-whisper-with-video
VIDEO_STILL_RESOLUTION=2k
# Optional: path to ffmpeg for MP4 export (otherwise the browser export stays WebM)
FFMPEG_PATH=
# ---- Voice Studio (voice library, speech, voice design / capture / clone) ----
# (empty)   -> wavespeed when WAVESPEED_API_KEY is set, otherwise mock
# wavespeed -> OmniVoice (speech in a voice), Qwen3 TTS Voice Design, Audio Vocal Isolator, Whisper, any-llm helper
# mock      -> no API calls: synthetic babble instead of speech (free UI testing)
VOICE_PROVIDER=
# Spend guard for the paid voice calls: server-wide daily budget in USD (empty = no limit) and requests per minute
# per client
VOICE_DAILY_BUDGET_USD=
VOICE_RATE_PER_MINUTE=40
# false = visitors cannot (re)make the built-in voices ("Create all" / "Regenerate" are hidden and refused)
VOICE_PRESETS_EDITABLE=true
WAVESPEED_OMNIVOICE_CLONE_MODEL=wavespeed-ai/omnivoice/voice-clone
WAVESPEED_QWEN_DESIGN_MODEL=wavespeed-ai/qwen3-tts/voice-design
WAVESPEED_VOCAL_ISOLATOR_MODEL=wavespeed-ai/audio-vocal-isolator
WAVESPEED_WHISPER_AUDIO_MODEL=wavespeed-ai/openai-whisper
# Turns a voice description (any language) into English for Qwen3, suggests a name and writes a sample phrase (~$0.001)
WAVESPEED_LLM_MODEL=wavespeed-ai/any-llm
VOICE_LLM=google/gemini-2.5-flash
# Sample clips of the built-in voices (default: server/voice-presets, committed so the catalog sounds the same everywhere)
VOICE_PRESETS_DIR=
# Private voice data, never served over HTTP: the user's voice list, the spend counter, mock clips (default: server/data)
VOICE_DATA_DIR=
# ---- Face Swap (head swap with the BFS LoRA) ----
# (empty)   -> wavespeed when WAVESPEED_API_KEY is set, otherwise mock
# wavespeed -> Qwen-Image 2.1 edit-lora + BFS "Best Face Swap" LoRA (2 pictures: 1K $0.045, 1.5K $0.08, 2K $0.145)
# mock      -> no API calls: the photo comes back unchanged (free UI testing)
FACESWAP_PROVIDER=
# Server-wide daily budget in USD (empty = no limit) and requests per minute per client
FACESWAP_DAILY_BUDGET_USD=
FACESWAP_RATE_PER_MINUTE=20
WAVESPEED_QWEN_EDIT_LORA_MODEL=wavespeed-ai/qwen-image-2.1/edit-lora
# Where WaveSpeed loads the LoRA files from (Civitai needs a login, the author's Hugging Face copy is public);
# versions: bfs_head_v1.1_qwen_2.1 (default), bfs_head_v1.1_alternative_qwen_2.1, bfs_head_v1_qwen_2.1
FACESWAP_LORA_BASE=https://huggingface.co/Alissonerdx/BFS-Best-Face-Swap/resolve/main/
# In-browser face finder model (MediaPipe), downloaded once and cached here (default: server/data/vision-models)
FACESWAP_VISION_DIR=
# Outbound networking for the server's own requests (WaveSpeed, result downloads): direct by default.
# HTTPS_PROXY routes them through a proxy (e.g. http://127.0.0.1:10809); USE_SYSTEM_PROXY=true picks the
# proxy enabled in Windows Internet Settings. CONNECT_TIMEOUT_MS: how long to wait for a connection (30000).
HTTPS_PROXY=
USE_SYSTEM_PROXY=false
CONNECT_TIMEOUT_MS=30000
# Where generated media is stored (default: server/storage)
MEDIA_DIR=

PORT=8787
# The API listens on loopback only (127.0.0.1 and ::1): pages reach it through the Vite proxy and nobody else on the
# network can use the paid keys. Set HOST=0.0.0.0 only behind a real login. CORS_ORIGINS: extra allowed origins.
# ALLOWED_HOSTS: extra host names requests may be addressed to (comma-separated; localhost is always allowed). Without
# HOST the server refuses any other name, which stops DNS-rebinding pages from reaching it through the browser.
HOST=
CORS_ORIGINS=
ALLOWED_HOSTS=
